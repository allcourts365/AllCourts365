{
  "name": "AllCourts365",
  "short_name": "AllCourts365",
  "description": "A central definitiva para gestão de Clubes, Rankings e Torneios.",
  "start_url": "/pwa/start/",
  "id": "/pwa/start/",
  "scope": "/",
  "display": "standalone",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "auto"
  },
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.json"
    }
  ],
  "icons": [
    {
      "src": "/static/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
